# Copy to .env.local for local development; never put real keys in this file.
# Provider keys are server-only. Never prefix provider secrets with NEXT_PUBLIC_.
GROQ_API_KEY=
GEMINI_API_KEY=

# Supabase project settings used by the browser/server auth clients.
# The publishable key is designed for client use; protect data with RLS policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
